# Copy to .env for local testing, and add the same values in Vercel → Project → Settings → Environment Variables.
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=paste-the-client-secret-here
# The site's own address, no trailing slash. Local: http://localhost:3000   Live: https://trackmade.com.au
PUBLIC_URL=http://localhost:3000
# Any long random string (used to encrypt the Strava cookie). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Leave unset in real use. Only for offline testing against dev/mock-strava.js
# STRAVA_BASE=http://localhost:3999
