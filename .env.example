# Copy to .env for local testing. On the live site, add the same names in Vercel → Project → Settings → Environment Variables.
# Leave a service's lines blank and the site uses a stand-in on your PC (and politely refuses on Vercel).

# The site's own address, no trailing slash. Local: http://localhost:3000   Live: https://trackmade.com.au
PUBLIC_URL=http://localhost:3000
# Any long random string (encrypts login cookies). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Strava (strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Only for offline testing against dev/mock-strava.js
# STRAVA_BASE=http://localhost:3999

# --- Orders database (Supabase → Project Settings → API). The secret/service key must never go in the page.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Payments (Stripe → Developers → API keys; webhook secret from Developers → Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emails (Resend → API keys). MAIL_FROM needs your domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=TrackMade <hello@trackmade.com.au>

# --- You
ADMIN_EMAIL=
# Dashboard password (trackmade.com.au/admin), 10+ characters
ADMIN_PASSWORD=
# Key TrackMade Studio uses to load orders, 24+ random characters
ADMIN_API_KEY=
